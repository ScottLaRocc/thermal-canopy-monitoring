
' CR310 - Four Amphenol EC95G104VN thermistors
' Half bridge with individual 1k reference resistors
'
' Wiring:
' All thermistor red wires -> VX1
'
' Thermistor 1 black -> H2 / SE3
' Thermistor 2 black -> L2 / SE4
' Thermistor 3 black -> H3 / SE5
' Thermistor 4 black -> L3 / SE6
'
' Each measurement terminal connects to its own
' 1k precision resistor, with the other resistor
' lead connected to analog ground.
'
' All four sensors share VX1 excitation.

' Declare Variables and Units

Public BattV
Public PTemp_C

Public ThermRatio_1
Public ThermRatio_2
Public ThermRatio_3
Public ThermRatio_4

Public ThermRes_1
Public ThermRes_2
Public ThermRes_3
Public ThermRes_4

Public ThermTemp_C_1
Public ThermTemp_C_2
Public ThermTemp_C_3
Public ThermTemp_C_4

' Reference resistor (ohms)
Const Rref = 100000

' Steinhart-Hart coefficients
Const SH_A = 0.0014890258100333767
Const SH_B = 0.00012148772112920084
Const SH_C = 3.0556633951101875E-07

Units BattV = Volts
Units PTemp_C = Deg C

Units ThermRatio_1 = V/V
Units ThermRatio_2 = V/V
Units ThermRatio_3 = V/V
Units ThermRatio_4 = V/V

Units ThermRes_1 = Ohms
Units ThermRes_2 = Ohms
Units ThermRes_3 = Ohms
Units ThermRes_4 = Ohms

Units ThermTemp_C_1 = Deg C
Units ThermTemp_C_2 = Deg C
Units ThermTemp_C_3 = Deg C
Units ThermTemp_C_4 = Deg C

' Define Data Table

DataTable(Table1_1min_Thermist, True, -1)

  DataInterval(0, 1, Min, 10)

  Average(1, BattV, FP2, False)
  Average(1, PTemp_C, FP2, False)

  ' Average temperatures, excluding NAN measurements
  Average(1, ThermTemp_C_1, IEEE4, ThermTemp_C_1 = NAN)
  Average(1, ThermTemp_C_2, IEEE4, ThermTemp_C_2 = NAN)
  Average(1, ThermTemp_C_3, IEEE4, ThermTemp_C_3 = NAN)
  Average(1, ThermTemp_C_4, IEEE4, ThermTemp_C_4 = NAN)

  ' Record thermistor resistances
  Sample(1, ThermRes_1, IEEE4)
  Sample(1, ThermRes_2, IEEE4)
  Sample(1, ThermRes_3, IEEE4)
  Sample(1, ThermRes_4, IEEE4)

  ' Record voltage ratios
  Sample(1, ThermRatio_1, IEEE4)
  Sample(1, ThermRatio_2, IEEE4)
  Sample(1, ThermRatio_3, IEEE4)
  Sample(1, ThermRatio_4, IEEE4)

EndTable

' Main Program

BeginProg

  ' Main scan every 15 seconds
  Scan(15, Sec, 0, 0)

    ' Datalogger battery voltage
    Battery(BattV)

    ' Datalogger panel temperature
    PanelTemp(PTemp_C, 60)

    ' ==========================================
    ' THERMISTOR 1 - SE3 / H2
    ' ==========================================

    BrHalf(ThermRatio_1, 1, mV2500, 3, VX1, 1, 2500, False, 500, 60, 1, 0)

    If ThermRatio_1 <= 0 OR ThermRatio_1 >= 1 Then
      ThermRes_1 = NAN
      ThermTemp_C_1 = NAN
    Else
      ThermRes_1 = Rref * (1 - ThermRatio_1) / ThermRatio_1
      ThermTemp_C_1 = 1 / (SH_A + SH_B * LN(ThermRes_1) + SH_C * (LN(ThermRes_1))^3) - 273.15
    EndIf

    ' ==========================================
    ' THERMISTOR 2 - SE4 / L2
    ' ==========================================

    BrHalf(ThermRatio_2, 1, mV2500, 4, VX1, 1, 2500, False, 500, 60, 1, 0)

    If ThermRatio_2 <= 0 OR ThermRatio_2 >= 1 Then
      ThermRes_2 = NAN
      ThermTemp_C_2 = NAN
    Else
      ThermRes_2 = Rref * (1 - ThermRatio_2) / ThermRatio_2
      ThermTemp_C_2 = 1 / (SH_A + SH_B * LN(ThermRes_2) + SH_C * (LN(ThermRes_2))^3) - 273.15
    EndIf

    ' ==========================================
    ' THERMISTOR 3 - SE5 / H3
    ' ==========================================

    BrHalf(ThermRatio_3, 1, mV2500, 5, VX1, 1, 2500, False, 500, 60, 1, 0)

    If ThermRatio_3 <= 0 OR ThermRatio_3 >= 1 Then
      ThermRes_3 = NAN
      ThermTemp_C_3 = NAN
    Else
      ThermRes_3 = Rref * (1 - ThermRatio_3) / ThermRatio_3
      ThermTemp_C_3 = 1 / (SH_A + SH_B * LN(ThermRes_3) + SH_C * (LN(ThermRes_3))^3) - 273.15
    EndIf

    ' ==========================================
    ' THERMISTOR 4 - SE6 / L3
    ' ==========================================

    BrHalf(ThermRatio_4, 1, mV2500, 6, VX1, 1, 2500, False, 500, 60, 1, 0)

    If ThermRatio_4 <= 0 OR ThermRatio_4 >= 1 Then
      ThermRes_4 = NAN
      ThermTemp_C_4 = NAN
    Else
      ThermRes_4 = Rref * (1 - ThermRatio_4) / ThermRatio_4
      ThermTemp_C_4 = 1 / (SH_A + SH_B * LN(ThermRes_4) + SH_C * (LN(ThermRes_4))^3) - 273.15
    EndIf

    ' Store averaged data every 1 minute
    CallTable Table1_1min_Thermist

  NextScan

EndProg